# Cloudinary Direct Browser Upload (Unsigned Preset)
# Set your Cloudinary Cloud Name and unsigned Upload Preset below.
# DO NOT include or expose your Cloudinary API Secret here!
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Neon PostgreSQL Connection String (Server-side only — DO NOT prefix with VITE_)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
